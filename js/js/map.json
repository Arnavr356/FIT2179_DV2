{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 800,
  "height": 500,

  "title": {
    "text": "Threatened Ecological Communities Across Australia",
    "fontSize": 24,
    "font": "Poppins",
    "color": "#1b4332"
  },

  "data": {
    "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
    "format": {
      "type": "topojson",
      "feature": "countries"
    }
  },

  "transform": [
    {
      "filter": "datum.id == 36"
    }
  ],

  "projection": {
    "type": "mercator"
  },

  "mark": {
    "type": "geoshape",
    "fill": "#74c69d",
    "stroke": "white",
    "strokeWidth": 1.5
  },

  "config": {
    "background": "#ffffff",
    "view": {
      "stroke": null
    }
  }
}