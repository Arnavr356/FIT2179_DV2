{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "url": "../data/status_totals.json" },
  "width": "container",
  "height": 280,
  "layer": [
    {
      "mark": { "type": "bar", "cornerRadiusTopLeft": 3, "cornerRadiusTopRight": 3 },
      "encoding": {
        "x": { "field": "type", "type": "nominal", "axis": { "title": null, "labelAngle": 0, "labelFontSize": 12 } },
        "y": { "field": "count", "type": "quantitative", "axis": { "title": "Count", "grid": true } },
        "xOffset": { "field": "status", "type": "nominal", "sort": ["Critically Endangered","Endangered","Vulnerable"] },
        "color": {
          "field": "status", "type": "nominal",
          "scale": { "domain": ["Critically Endangered","Endangered","Vulnerable"], "range": ["#c84b31","#d98841","#e1b12c"] },
          "legend": { "title": "Threat status", "orient": "top" }
        },
        "tooltip": [
          { "field": "type", "title": "Category" },
          { "field": "status", "title": "Status" },
          { "field": "count", "title": "Count" }
        ]
      }
    },
    {
      "mark": { "type": "text", "dy": -7, "fontSize": 10, "fontWeight": "600", "color": "#2c3e2d" },
      "transform": [
        { "filter": { "field": "type", "equal": "Communities" } },
        { "filter": { "field": "status", "equal": "Critically Endangered" } }
      ],
      "encoding": {
        "x": { "field": "type", "type": "nominal" },
        "xOffset": { "field": "status", "type": "nominal", "sort": ["Critically Endangered","Endangered","Vulnerable"] },
        "y": { "field": "count", "type": "quantitative" },
        "text": { "value": "44% CE!" }
      }
    }
  ]
}
