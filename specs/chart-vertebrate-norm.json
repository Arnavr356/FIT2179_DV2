{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "url": "../data/vertebrate_detail.json" },
  "width": "container",
  "height": 300,
  "layer": [
    {
      "mark": { "type": "bar", "cornerRadiusTopLeft": 3, "cornerRadiusTopRight": 3 },
      "encoding": {
        "x": {
          "field": "group", "type": "nominal",
          "sort": ["-ce_pct"],
          "axis": { "title": null, "labelAngle": 0, "labelFontSize": 13 }
        },
        "y": {
          "field": "count", "type": "quantitative",
          "stack": "normalize",
          "axis": {
            "title": "Proportion of threatened species",
            "format": ".0%",
            "labelExpr": "format(datum.value, '.0%')"
          }
        },
        "color": {
          "field": "status", "type": "nominal",
          "scale": { "domain": ["Critically Endangered","Endangered","Vulnerable"], "range": ["#c84b31","#d98841","#e1b12c"] },
          "legend": { "title": "Threat status", "orient": "right", "symbolLimit": 3 }
        },
        "order": { "field": "status", "sort": "ascending" },
        "tooltip": [
          { "field": "group", "title": "Animal group" },
          { "field": "status", "title": "Status" },
          { "field": "count", "title": "Species count" },
          { "field": "pct", "title": "% of group", "format": ".1f" }
        ]
      }
    },
    {
      "mark": { "type": "rule", "color": "#c84b31", "strokeDash": [5,3], "strokeWidth": 1.5 },
      "data": { "values": [{}] },
      "encoding": { "y": { "datum": 0.35, "type": "quantitative" } }
    },
    {
      "mark": { "type": "text", "align": "right", "dx": -4, "dy": -6, "fontSize": 9, "color": "#c84b31", "fontWeight": "700" },
      "data": { "values": [{ "label": "35% CE threshold" }] },
      "encoding": {
        "x": { "datum": "Reptiles" },
        "y": { "datum": 0.35, "type": "quantitative" },
        "text": { "field": "label" }
      }
    }
  ]
}
